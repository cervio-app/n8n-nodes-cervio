# Required for live smoke scripts (npm run smoke / smoke:extended / smoke:relations).
# Copy to .env locally — .env is gitignored. There are no shared tenant defaults.
CERVIO_BASE_URL=https://YOUR_TENANT.cervio.app
CERVIO_PAT=cpat_replace_me

# Required by smoke + smoke:extended (entity with form/view `default` + `stato` field)
CERVIO_SMOKE_ENTITY_ID=

# Optional for smoke:extended — N:M link/unlink section
# CERVIO_SMOKE_CORSO_ID=
# CERVIO_SMOKE_ARGOMENTO_ID=
# CERVIO_SMOKE_THROUGH_FIELD=

# Optional for smoke:extended — workflow start + run status
# CERVIO_SMOKE_WORKFLOW_ID=

# Optional cleanup / keep
# CERVIO_SMOKE_KEEP=1
# CERVIO_SMOKE_DELETE_ID=

# Required by smoke:relations (all of these entity UUIDs)
# CERVIO_SMOKE_CORSO_ID=
# CERVIO_SMOKE_SEDE_ID=
# CERVIO_SMOKE_DOCENTE_ID=
# CERVIO_SMOKE_LEZIONE_ID=
# CERVIO_SMOKE_ARGOMENTO_ID=
# CERVIO_SMOKE_ORDINE_ID=
# CERVIO_SMOKE_CLIENTE_ID=
# CERVIO_SMOKE_RIGA_ID=
# CERVIO_SMOKE_ENG_PROJECT_ID=
# CERVIO_SMOKE_BUSINESS_UNIT_ID=
# CERVIO_SMOKE_CONTRIBUTOR_ID=

# Optional for smoke:relations — faster local loops
# CERVIO_SKIP_SEED50=1
