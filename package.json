{
  "name": "@cervio/n8n-nodes-cervio",
  "version": "0.2.3",
  "description": "n8n community node for Cervio — entity records, documents, N:M links, and workflows via REST /api/v1",
  "license": "MIT",
  "homepage": "https://github.com/cervio-app/n8n-nodes-cervio#readme",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "cervio",
    "crm",
    "workflow"
  ],
  "author": {
    "name": "Cervio",
    "email": "infra@cervio.app"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cervio-app/n8n-nodes-cervio.git"
  },
  "bugs": {
    "url": "https://github.com/cervio-app/n8n-nodes-cervio/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-icons.mjs",
    "build:watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "smoke:relations": "node scripts/smoke-relations.mjs",
    "smoke:extended": "node scripts/smoke-extended.mjs",
    "verify": "node scripts/verify-node-load.mjs",
    "lint": "npm run lint:tsc && npm run lint:eslint",
    "lint:tsc": "tsc --noEmit",
    "lint:eslint": "eslint .",
    "prepublishOnly": "npm run lint && npm run build && npm test && npm run verify"
  },
  "files": [
    "dist",
    "media"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/CervioApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Cervio/Cervio.node.js"
    ]
  },
  "devDependencies": {
    "@eslint/json": "^2.1.1",
    "@n8n/eslint-plugin-community-nodes": "^1.0.1",
    "eslint": "^9.29.0",
    "n8n-workflow": "^2.16.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "peerDependenciesMeta": {
    "n8n-workflow": {
      "optional": true
    }
  }
}
